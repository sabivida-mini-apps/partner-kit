// Starter partner app on Cloudflare Workers (../docs/developer-guide.md). Rename it.
// Set the SabiVida host, app id and, for a host behind an access gate, its
// public keys and an SDK copy through deploy.mjs.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-sabivida-mini-app",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
}
